// See https://aka.ms/bicep/config for more information on Bicep configuration options
// Press CTRL+SPACE at any location to see Intellisense suggestions
{
    "extensions": {
        "microsoftGraphV1": "br:mcr.microsoft.com/bicep/extensions/microsoftgraph/v1.0:1.0.0"
    },
    // "formatting": {
    //     "indentSize": 2,
    //     "indentStyle": "space",
    //     "newLine": "\n",
    //     "insertSpaces": true,
    //     "trimTrailingWhitespace": true,
    //     "keepLines": false
    // },
    "analyzers": {
        "core": {
            "rules": {
                "use-recent-api-versions": {
                    "level": "warning"
                },
                "use-recent-module-versions": {
                    "level": "warning",
                    "message": "The module version is outdated. Please consider updating to the latest version."
                },
                "use-resource-id-functions": {
                  "level": "warning"
                },
                "no-unused-params": {
                    "level": "warning"
                },
                "no-unused-vars": {
                    "level": "warning"
                }
            }
        }
    }    
}
