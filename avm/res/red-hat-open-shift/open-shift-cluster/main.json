        "platformWorkloadIdentityProfile": "[if(variables('isManagedIdentityCluster'), createObject('platformWorkloadIdentities', parameters('platformWorkloadIdentities'), 'upgradeableTo', parameters('upgradeableTo')), null())]",
        "servicePrincipalProfile": "[if(variables('isManagedIdentityCluster'), null(), parameters('servicePrincipalProfile'))]"
      }
